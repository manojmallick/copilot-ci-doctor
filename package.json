{
  "name": "copilot-ci-doctor",
  "version": "2.0.0",
  "description": "CLI tool that diagnoses GitHub Actions CI failures using GitHub Copilot CLI as the reasoning engine",
  "keywords": [
    "github-actions",
    "ci",
    "ci-cd",
    "github-copilot",
    "copilot-cli",
    "devops",
    "debugging",
    "cli",
    "automation"
  ],
  "homepage": "https://manojmallick.github.io/copilot-ci-doctor/",
  "bugs": {
    "url": "https://github.com/manojmallick/copilot-ci-doctor/issues"
  },
  "type": "module",
  "bin": {
    "copilot-ci-doctor": "./src/cli.js"
  },
  "files": [
    "src",
    "prompts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test test/*.test.js",
    "test:bin": "node src/cli.js --help",
    "check": "node --check src/cli.js",
    "prepublishOnly": "npm test",
    "lint": "eslint ."
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "execa": "^9.5.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/manojmallick/copilot-ci-doctor"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0"
  }
}
